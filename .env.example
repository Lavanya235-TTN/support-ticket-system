# Copy to `.env` in the repo root (git-ignored). Used by `docker compose` and local backend runs.
# Placeholder values only — do not commit real secrets (NFR-04-AC2).

# PostgreSQL (Docker Compose `postgres` service)
POSTGRES_DB=support_ticket
POSTGRES_USER=support_ticket
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# Spring Boot datasource (host connects to published Compose port on localhost)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/support_ticket
SPRING_DATASOURCE_USERNAME=support_ticket
SPRING_DATASOURCE_PASSWORD=changeme
